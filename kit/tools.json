{
  "version": "1.0.0",
  "python": {"min": "3.10", "max": "3.12", "recommended": "3.11",
             "install_hint": {"windows": "winget install Python.Python.3.11", "macos": "https://www.python.org/downloads/ (hoặc brew install python@3.11)"}},
  "pip": [
    "faster-whisper==1.2.1", "onnxruntime==1.23.2", "numpy==2.4.6", "pillow==12.3.0",
    "opencv-python-headless==5.0.0.93", "mediapipe==0.10.14", "fastapi==0.143.0", "uvicorn==0.54.0",
    "python-multipart==0.0.32", "psutil==7.1.0", "pydantic==2.14.0", "noisereduce==3.0.3", "scipy==1.17.1"
  ],
  "ffmpeg": {
    "purpose": "đọc/chuẩn hoá media, dựng thô, encode, mix, loudnorm, đo",
    "use_system_if_present": true,
    "download": {
      "windows": {"url": "https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-win64-gpl.zip", "type": "zip", "bins": ["ffmpeg.exe", "ffprobe.exe"]},
      "macos_x86_64": [{"url": "https://evermeet.cx/ffmpeg/getrelease/zip", "bin": "ffmpeg"}, {"url": "https://evermeet.cx/ffprobe/getrelease/zip", "bin": "ffprobe"}],
      "macos_arm64": {"hint": "brew install ffmpeg (bản evermeet là x86_64, chạy được qua Rosetta nhưng chậm)"}
    },
    "needs_filters": ["zscale", "tonemap", "loudnorm", "afftdn", "ebur128", "showspectrumpic"]
  },
  "models": {
    "rvm": {"purpose": "tách nhân vật động (alpha theo thời gian)", "license": "GPL-3.0",
